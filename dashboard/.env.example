# Copy to .env.local for `npm run dev`, and paste these into Vercel's
# Environment Variables UI for production. Get all three values from
# your Supabase project: https://app.supabase.com/project/_/settings/api

NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...
